version: 1

# Optional external controller. Create and maintain it with workspace-control-hub.
control_hub:
  root: ~/dev/control-hubs/example

sources:
  primary:
    root: ~/dev/source-catalog
  shared:
    root: ~/dev/shared-catalog

repositories:
  required:
    - name: core-api
      source: primary
      role: core-api
      criticality: critical
      codegraph: true
    - name: partner-api
      source: primary
      role: integrations
      criticality: high
  optional:
    - name: contracts
      source: shared
      role: interface-documentation
      criticality: medium
    - name: customer-web
      source: primary
      role: frontend
      criticality: high
