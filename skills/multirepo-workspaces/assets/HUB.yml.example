version: 1

# Optional external controller. Create and maintain it with workspace-control-hub.
control_hub:
  root: ~/dev/control-hubs/example

# Optional ordered memory. The managed primary is writable only through knowledge-vault;
# later local entries are read-only context.
memory:
  - name: vault
    type: local
    path: ~/Documents/vaults/example
    skill: knowledge-vault
    config:
      vault: Example
  - name: knowledge-hub
    type: local
    path: ~/dev/example/knowledge-hub

sources:
  primary:
    root: ~/dev/source-catalog
  shared:
    root: ~/dev/shared-catalog

repositories:
  required:
    - name: core-api
      source: primary
      role: core-api
      criticality: critical
      codegraph: true
    - name: partner-api
      source: primary
      role: integrations
      criticality: high
  optional:
    - name: contracts
      source: shared
      role: interface-documentation
      criticality: medium
    - name: customer-web
      source: primary
      role: frontend
      criticality: high
